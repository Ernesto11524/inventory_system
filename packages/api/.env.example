# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://inventory_user:inventory_pass@localhost:5432/inventory_db

# ─── Redis (Upstash for prod, local redis URL for dev) ────────────────────────
REDIS_URL=redis://localhost:6379
# For production (Upstash):
# UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-to-a-strong-random-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-another-strong-random-secret-32-chars-min

# ─── App ──────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:19006
WEB_APP_URL=http://localhost:3000

# ─── Cloudinary ───────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
ALERT_EMAIL=alerts@yourcompany.com

# ─── Twilio (SMS) ─────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+15550000000
ALERT_PHONE=+15551234567
